rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function subscriptionData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasActiveSubscription() {
      return isSignedIn() && (
        subscriptionData().subscriptionStatus == 'active' ||
        subscriptionData().subscriptionStatus == 'trialing'
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /quizzes/{quizId} {
      allow read, delete: if hasActiveSubscription() && resource.data.user == request.auth.uid;
      allow create: if hasActiveSubscription() && request.resource.data.user == request.auth.uid;
      allow update: if hasActiveSubscription() &&
        resource.data.user == request.auth.uid &&
        request.resource.data.user == request.auth.uid;
    }

    match /quizzers/{quizzerId} {
      allow read, delete: if hasActiveSubscription() && resource.data.createdByUser == request.auth.uid;
      allow create: if hasActiveSubscription() && request.resource.data.createdByUser == request.auth.uid;
      allow update: if hasActiveSubscription() &&
        resource.data.createdByUser == request.auth.uid &&
        request.resource.data.createdByUser == request.auth.uid;
    }
  }
}